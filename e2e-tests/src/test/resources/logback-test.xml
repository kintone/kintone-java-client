<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d [%thread] %logger %msg%n</pattern>
    </encoder>
  </appender>

  <logger name="com.kintone.client.requestLog" level="debug" />

  <root level="info">
    <appender-ref ref="STDOUT" />
  </root>

</configuration>
